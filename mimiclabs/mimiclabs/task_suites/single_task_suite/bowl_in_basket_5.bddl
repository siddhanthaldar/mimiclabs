(define (problem MimicLabs_Lab1_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bowl in the basket)
    (:regions
      (basket_init_region
          (:target table)
          (:ranges (
              (-0.15 0.05 0.05 0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bowl_init_region
          (:target table)
          (:ranges (
              (-0.15 -0.25 0.05 0.0)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    table - table
  )

  (:objects
    basket - libero_basket_0
    bowl - robocasa_bowl_6
  )

  (:obj_of_interest
    basket
    bowl
  )

  (:init
    (On basket table_basket_init_region)
    (On bowl table_bowl_init_region)
  )

  (:goal
    (And (On bowl basket))
  )

  (:demonstration
    (Grasp bowl)
    (On bowl basket)
  )

)
